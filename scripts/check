#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
config="$HOME/.config/herdr/config.toml"
worktrunk_config="$HOME/.config/herdr/plugins/config/worktrunk/config.toml"

if [[ ! -L "$config" || "$(readlink "$config")" != "$root/config/config.toml" ]]; then
  printf 'Herdr config is not linked to herdr-personal.\n' >&2
  exit 1
fi
if [[ ! -L "$worktrunk_config" || "$(readlink "$worktrunk_config")" != "$root/config/plugins/worktrunk/config.toml" ]]; then
  printf 'Worktrunk plugin config is not linked to herdr-personal.\n' >&2
  exit 1
fi

gh_bin=$(MISE_GITHUB_CREDENTIAL_COMMAND= mise -C "$root" --no-env --no-hooks which gh)
if [[ ! -x "$HOME/.local/bin/gh" || "$(readlink "$HOME/.local/bin/gh")" != "$gh_bin" ]]; then
  printf 'gh must link directly to its installed executable. Rerun bootstrap.\n' >&2
  exit 1
fi

if [[ $(herdr --version) != "herdr 0.9.0" ]]; then
  printf 'Expected Herdr 0.9.0.\n' >&2
  exit 1
fi
if [[ $("$HOME/.local/bin/wt" --version) != "wt v0.77.0" ]]; then
  printf 'Expected Worktrunk 0.77.0.\n' >&2
  exit 1
fi
if [[ ! -x "$HOME/.local/bin/herdr-pane-history" ]]; then
  printf 'Missing herdr-pane-history launcher.\n' >&2
  exit 1
fi
for tool in bun herdr; do
  launcher="$HOME/.local/bin/$tool"
  if [[ ! -L "$launcher" || "$(readlink "$launcher")" != "$root/bin/mise-tool" ]]; then
    printf 'Missing Herdr runtime launcher: %s.\n' "$tool" >&2
    exit 1
  fi
done

plugins=$(herdr plugin list --json)
while IFS=$'\t' read -r plugin_id _ ref; do
  [[ -n "$plugin_id" ]] || continue
  if ! jq -e --arg id "$plugin_id" --arg ref "$ref" \
    '.result.plugins[] | select(.plugin_id == $id and .source.requested_ref == $ref)' \
    <<<"$plugins" >/dev/null; then
    printf 'Missing Herdr plugin %s at %s.\n' "$plugin_id" "$ref" >&2
    exit 1
  fi
done < "$root/plugins.tsv"

layouts_manifest=$(jq -r \
  '.result.plugins[] | select(.plugin_id == "local.layouts") | .manifest_path' \
  <<<"$plugins")
if [[ "$layouts_manifest" != "$root/layouts/herdr-plugin.toml" ]]; then
  printf 'Arrange is not linked from herdr-personal.\n' >&2
  exit 1
fi

printf 'Portable Herdr setup is ready.\n'
